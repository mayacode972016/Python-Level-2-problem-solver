def waitlist(classList):
    enrolled = []
    waitlisted = set()

    for student in classList:
        if student in enrolled:
            continue
        elif len(enrolled) < 6:
            enrolled.append(student)
        else:
            waitlisted.add(student)

    return waitlisted

print("Waitlisted for Biology:", waitlist(biology))
print("Waitlisted for Computer Science:", waitlist(computerScience))
print("Waitlisted for English:", waitlist(english))




