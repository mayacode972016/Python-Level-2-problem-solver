def getevens(nums):
  evens = set()
  for num in nums:
    if num % 2 == 0:
      evens.append(num)
  return evens

def pickThrees (words):
  threeLetterWords = set()
  for word in words:
    if len(word) == 3:
      threeLetterWords.append
  return threeLetterWords
